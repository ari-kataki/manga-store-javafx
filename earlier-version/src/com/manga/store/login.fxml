<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.manga.store.LoginController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: #8d09e1; -fx-padding: 50;">

    <!-- Titolo -->
    <ImageView fitHeight="90" preserveRatio="true">
        <image>
            <Image url="@logo_mangaworld_web.png" />
        </image>
    </ImageView>

    <Label text="Enter your account"
           style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;"/>

    <!-- Spazio -->
    <Region prefHeight="10"/>

    <!-- Campo username -->
    <TextField fx:id="usernameField"
               promptText="Username"
               maxWidth="280"
               style="-fx-background-color: #16213e;
                      -fx-text-fill: white;
                      -fx-prompt-text-fill: #666666;
                      -fx-border-color: #e94560;
                      -fx-border-radius: 6;
                      -fx-background-radius: 6;
                      -fx-padding: 10;
                      -fx-font-size: 13px;"/>

    <!-- Campo password -->
    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="280"
                   style="-fx-background-color: #16213e;
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: #666666;
                          -fx-border-color: #ec4962;
                          -fx-border-radius: 6;
                          -fx-background-radius: 6;
                          -fx-padding: 10;
                          -fx-font-size: 13px;"/>

    <!-- Bottone login -->
    <Button fx:id="loginButton"
            text="LOGIN"
            onAction="#handleLogin"
            maxWidth="280"
            style="-fx-background-color: #e94560;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-font-size: 14px;
                   -fx-cursor: hand;
                   -fx-background-radius: 6;
                   -fx-padding: 11;"/>

    <!-- Messaggio di errore/successo -->
    <Label fx:id="messageLabel"
           text=""
           style="-fx-text-fill: #ffdddd; -fx-font-size: 12px;"/>

</VBox>
