<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.manga.store.MangaController"
      spacing="0"
      style="-fx-background-color: #1a1a2e;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT"
          spacing="10"
          style="-fx-background-color: #16213e;
                 -fx-padding: 15 20;
                 -fx-border-color: #0f3460;
                 -fx-border-width: 0 0 2 0;">

        <ImageView fitHeight="90" preserveRatio="true">
            <image>
                <Image url="@logo_mangaworld_web.png" />
            </image>
        </ImageView>

        <!-- flex -->
        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="logoutButton"
                text="Log out"
                onAction="#handleLogout"
                style="-fx-background-color: #e94560;
                       -fx-text-fill: white;
                       -fx-font-size: 12px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-background-radius: 5;
                       -fx-padding: 6 14;"/>
    </HBox>

    <!-- subtit -->
    <Label text="I nostri manga disponibili"
           style="-fx-text-fill: #aaaaaa;
                  -fx-font-size: 12px;
                  -fx-padding: 12 20 6 20;"/>

    <!-- manga list -->
    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: #1a1a2e;
                       -fx-background-color: #1a1a2e;
                       -fx-border-color: transparent;">

        <VBox fx:id="mangaContainer"
              spacing="10"
              style="-fx-padding: 10 20 20 20; -fx-background-color: #1a1a2e;"/>

    </ScrollPane>

</VBox>
