<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.com.manga.store.cart.CartController"
      spacing="0"
      style="-fx-background-color: #1a1a2e;">


    <HBox alignment="CENTER_LEFT"
          spacing="10"
          style="-fx-background-color: #16213e;
                 -fx-padding: 14 20;
                 -fx-border-color: #0f3460;
                 -fx-border-width: 0 0 2 0;">

        <Button fx:id="backButton"
                text="← Back to Store"
                onAction="#handleBack"
                style="-fx-background-color: #0f3460;
                       -fx-text-fill: #aaaaaa;
                       -fx-font-size: 12px;
                       -fx-cursor: hand;
                       -fx-background-radius: 5;
                       -fx-padding: 7 14;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Your Cart"
               style="-fx-text-fill: #e94560; -fx-font-size: 20px; -fx-font-weight: bold;"/>
    </HBox>

    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: #1a1a2e;
                       -fx-background-color: #1a1a2e;
                       -fx-border-color: transparent;">

        <VBox fx:id="cartContainer"
              spacing="10"
              style="-fx-padding: 14 20 20 20;
                     -fx-background-color: #1a1a2e;"/>

    </ScrollPane>


    <HBox alignment="CENTER_RIGHT"
          spacing="20"
          style="-fx-background-color: #16213e;
                 -fx-padding: 16 20;
                 -fx-border-color: #0f3460;
                 -fx-border-width: 2 0 0 0;">

        <Label fx:id="totalLabel"
               text="Total: € 0,00"
               style="-fx-text-fill: #ffffff; -fx-font-size: 16px; -fx-font-weight: bold;"/>

        <Button fx:id="orderButton"
                text="Place Order"
                onAction="#handleOrder"
                style="-fx-background-color: #e94560;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-background-radius: 6;
                       -fx-padding: 10 22;"/>
    </HBox>

</VBox>
